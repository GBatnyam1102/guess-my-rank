# Copy to .env. Everything is optional for local development.
PORT=4000
# HOST=0.0.0.0   (default: every interface, IPv4 + IPv6)

# Empty = in-memory store (state is lost on restart). Set it to keep games across restarts (NFR-08).
DATABASE_URL=postgres://postgres@localhost:5432/guess_my_rank

# Comma separated list, or * to allow any origin (development only).
CORS_ORIGINS=*

# local = files under STORAGE_DIR served by this server; db = rows in PostgreSQL (hosts without a disk,
# needs DATABASE_URL); r2 = Cloudflare R2 presigned uploads.
STORAGE_DRIVER=local
STORAGE_DIR=data/uploads
UPLOAD_SIGNING_SECRET=change-me

# Cleanup of expired images and stale rooms, default 10 min. Production on Neon uses 3600000 (hourly).
# SWEEP_INTERVAL_MS=600000
# Requested every 10 min to keep a free Render instance awake, e.g. https://api.example.mn/health
# KEEPALIVE_URL=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL of the bucket (custom domain or r2.dev), no trailing slash.
R2_PUBLIC_URL=
