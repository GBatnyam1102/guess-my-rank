# Caddy gets and renews Let's Encrypt certificates on its own.
# Cloudflare DNS records must be "DNS only" (grey cloud) so the HTTP challenge reaches this VM.

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Game server: Socket.IO (WebSocket), uploads, images, /health.
api.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy server:4000
}
